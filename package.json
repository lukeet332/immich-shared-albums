{
  "name": "immich-shared-albums",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p src/web/ui",
    "check:rust": "cargo check --lib",
    "lint": "eslint src/web/ui",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/web/ui/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"src/web/ui/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.json\"",
    "cycles": "node scripts/check-cycles.mjs",
    "verify": "npm run verify:fast",
    "verify:fast": "npm run build:web && npm run format:check && npm run lint && npm run typecheck && npm run cycles && node scripts/check-tokens.mjs && node scripts/check-contrast.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "build:web": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "@number0/iroh": "1.1.0"
  },
  "dependencies": {}
}

# Add inside your existing Immich site block, BEFORE the catch-all route.
handle /sidecar/* {
	reverse_proxy immich-shared:8300
}
# join banner on share pages; belt-and-braces fallback keeps share pages
# working even if the sidecar is down
handle /share/* {
	reverse_proxy immich-shared:8300 immich-server:2283 {
		lb_policy first
	}
}
